# Google Ads Conversion-Messung. Werte aus Google Ads > Zielvorhaben > Conversions > Tag-Einrichtung.
# Kopie als .env anlegen und echte Werte eintragen. Platzhalter mit XXXX bleiben inaktiv.
VITE_GADS_ID=AW-XXXXXXXXX
VITE_GADS_LABEL=XXXXXXXXXXX

# Meta Pixel (Datensatz "Skill Cologne"). Ohne Wert greift der Fallback in src/lib/magicline.ts.
VITE_META_PIXEL_ID=577923356905873

# Stripe Payment Link für START 39 per Karte/Apple Pay (Abo 39 € alle 4 Wochen). Leer = nur SEPA.
VITE_STRIPE_LINK_START39=https://buy.stripe.com/fZucN5eMz6Evg6kghN5EY07

VITE_STRIPE_PK=pk_live_...

# Serverseitig (nur Netlify, nie VITE_): Stripe-Abo für den Express-Abschluss und Webhook-Prüfung
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_START39=price_1UKJ06HMQZbugHGZAWBPGBNv
# Black Month (Einmalzahlung 149 €), Payment Link aus scripts/stripe-blackmonth.mjs
VITE_STRIPE_LINK_BLACKMONTH=

# Onboarding-Buchung (docs/onboarding-setup.md)
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
ONBOARDING_SECRET=
